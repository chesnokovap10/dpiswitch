# build output
/dist/
*.exe
*.exe~*

# AmneziaWG and mihomo configs contain private keys -- never commit them
*.conf
config*.yaml

# runtime data (lives in %ProgramData%\dpiswitch, ignored just in case)
*.log
*.jsonl
cache.db
controller-state*.json
settings.json

# editors
.vscode/
.idea/

# embedded core, produced by build.ps1
internal/core/mihomo.exe.gz
internal/core/mihomo.exe.sha256

# the exe's icon, version and manifest, written anew by build.ps1 at every build
cmd/dpiswitch/rsrc_*.syso
