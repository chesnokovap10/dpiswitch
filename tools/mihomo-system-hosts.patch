+func TestTunnelContextKeepsExplicitHostsAndIsolation(t *testing.T) {
+	old := DefaultHosts
+	DefaultHosts = NewHosts(trie.New[HostValue]())
+	t.Cleanup(func() { DefaultHosts = old })
+	pin, _ := NewHostValue([]string{"192.0.2.19"})
+	DefaultHosts.Insert("configured.example", pin)
+	ctx := WithoutSystemHosts(context.Background(), "configured.example")
+	got, err := LookupIPWithResolver(ctx, "configured.example", hostsTestResolver{})
+	if err != nil || len(got) != 1 || got[0].String() != "192.0.2.19" {
+		t.Fatalf("YAML hosts must be preserved: %v %v", got, err)
+	}
+	got, err = LookupIPWithResolver(ctx, "unconfigured.example", hostsTestResolver{})
+	if err != nil || len(got) != 1 || got[0].String() != "203.0.113.19" {
+		t.Fatalf("remote resolver not used: %v %v", got, err)
+	}
+	if systemHostsIgnored(context.Background(), "configured.example") {
+		t.Fatal("tunnel context leaked into another connection")
+	}
+	if !systemHostsIgnored(ctx, "CONFIGURED.EXAMPLE.") || systemHostsIgnored(ctx, "dns-server.example") {
+		t.Fatal("hosts exception escaped its target domain")
+	}
+	if systemHostsIgnored(WithSystemHosts(ctx), "configured.example") {
+		t.Fatal("outer tunnel peer inherited a hosts exception")
+	}
+}
