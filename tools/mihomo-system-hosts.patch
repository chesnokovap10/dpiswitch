+// This is a socket-level test with an isolated hosts fixture, not the machine's
+// hosts. Both direct adapters must hit the pinned server, never the other one.
+func TestDirectSocketsRespectPinAfterTunnelResolution(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "hosts")
+	if err := os.WriteFile(file, []byte("127.0.0.1 protected.example\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(hosts.SetFileForTest(file))
+	oldPolicy, oldUse := resolver.SystemHostsDirectOnly, resolver.UseSystemHosts
+	resolver.SystemHostsDirectOnly, resolver.UseSystemHosts = true, true
+	t.Cleanup(func() { resolver.SystemHostsDirectOnly, resolver.UseSystemHosts = oldPolicy, oldUse })
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			c.Write([]byte("pin"))
+			c.Close()
+		}
+	}()
+	port := uint16(ln.Addr().(*net.TCPAddr).Port)
+	for _, d := range []*outbound.Direct{outbound.NewDirect(), outbound.NewDirectWithOption(outbound.DirectOption{Name: "direct-split", TLSSplit: true})} {
+		m := &C.Metadata{Host: "protected.example", NetWork: C.TCP, DstPort: port}
+		hostpolicy.CaptureSystemHosts(m)
+		m.DstIP = netip.MustParseAddr("127.0.0.2") // address learned inside a tunnel
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		c, err := d.DialContext(ctx, m)
+		cancel()
+		if err != nil {
+			t.Fatal(err)
+		}
+		buf := make([]byte, 3)
+		c.SetReadDeadline(time.Now().Add(time.Second))
+		n, err := c.Read(buf)
+		c.Close()
+		if err != nil || string(buf[:n]) != "pin" {
+			t.Fatalf("wrong destination: %q %v", buf[:n], err)
+		}
+		udp := &C.Metadata{Host: "protected.example", NetWork: C.UDP, DstIP: netip.MustParseAddr("127.0.0.2"), DstPort: 443}
+		if err := d.ResolveUDP(context.Background(), udp); err != nil || udp.DstIP.String() != "127.0.0.1" || udp.Host != "protected.example" {
+			t.Fatalf("UDP escaped pin: %+v %v", udp, err)
+		}
+	}
+	if err := os.Remove(file); err != nil {
+		t.Fatal(err)
+	}
+	d := outbound.NewDirect()
+	if _, err := d.DialContext(context.Background(), &C.Metadata{Host: "protected.example", DstPort: port}); err == nil {
+		t.Fatal("missing hosts permitted a connection")
+	}
+	// Global switch is unchanged by tunnel resolution contexts.
+	if !resolver.UseSystemHosts {
+		t.Fatal(fmt.Errorf("global system hosts switch changed"))
+	}
+}
+
+type publicResolver struct {
+	resolver.Resolver
+	exchanges int
+}
+
+func (r *publicResolver) Invalid() bool { return true }
+func (r *publicResolver) LookupIP(context.Context, string) ([]netip.Addr, error) {
+	return []netip.Addr{netip.MustParseAddr("203.0.113.19")}, nil
+}
+func (r *publicResolver) LookupIPv4(c context.Context, s string) ([]netip.Addr, error) {
+	return r.LookupIP(c, s)
+}
+func (r *publicResolver) LookupIPv6(context.Context, string) ([]netip.Addr, error) {
+	return []netip.Addr{netip.MustParseAddr("2001:db8::19")}, nil
+}
+func (r *publicResolver) ExchangeContext(_ context.Context, q *D.Msg) (*D.Msg, error) {
+	r.exchanges++
+	return nil, fmt.Errorf("public DNS must not be reached for protected client queries")
+}
+
+func TestClientDNSNeverDisclosesPublicAddress(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "hosts")
+	if err := os.WriteFile(file, []byte("192.0.2.19 protected.example\n2001:db8::1 protected.example\n192.0.2.20 dns-server.example\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(hosts.SetFileForTest(file))
+	oldPolicy, oldUse := resolver.SystemHostsDirectOnly, resolver.UseSystemHosts
+	resolver.SystemHostsDirectOnly, resolver.UseSystemHosts = true, true
+	t.Cleanup(func() { resolver.SystemHostsDirectOnly, resolver.UseSystemHosts = oldPolicy, oldUse })
+	r := &publicResolver{}
+	svc := coreDNS.NewService(r, coreDNS.NewEnhancer(coreDNS.EnhancerConfig{IPv6: true, UseHosts: true, EnhancedMode: C.DNSNormal}))
+	for _, qt := range []uint16{D.TypeA, D.TypeAAAA, D.TypeHTTPS, D.TypeSVCB, D.TypeCNAME} {
+		q := new(D.Msg)
+		q.SetQuestion("protected.example.", qt)
+		a, err := svc.ServeMsg(context.Background(), q)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if qt == D.TypeA || qt == D.TypeAAAA {
+			if len(a.Answer) != 1 {
+				t.Fatalf("missing pin: %v", a)
+			}
+		} else if len(a.Answer) != 0 {
+			t.Fatalf("address hints escaped: %v", a)
+		}
+	}
+	if r.exchanges != 0 {
+		t.Fatalf("%d public DNS exchanges", r.exchanges)
+	}
+	if node, ok := resolver.DefaultHosts.SearchForRouting("protected.example", false); ok || node != nil {
+		t.Fatal("system pin was applied before routing")
+	}
+	for _, tc := range []struct {
+		ctx  context.Context
+		want string
+	}{{resolver.WithoutSystemHosts(context.Background(), "protected.example"), "203.0.113.19"}, {context.Background(), "192.0.2.19"}} {
+		ips, err := resolver.LookupIPWithResolver(tc.ctx, "protected.example", r)
+		if err != nil || len(ips) == 0 {
+			t.Fatal(err)
+		}
+		if ips[0].String() != tc.want {
+			t.Fatalf("wrong resolver path: %v, want %s", ips, tc.want)
+		}
+	}
+	bootstrapIPs, err := resolver.LookupIPWithResolver(resolver.WithoutSystemHosts(context.Background(), "protected.example"), "dns-server.example", r)
+	if err != nil || len(bootstrapIPs) != 1 || bootstrapIPs[0].String() != "192.0.2.20" {
+		t.Fatalf("DNS bootstrap lost its hosts pin: %v %v", bootstrapIPs, err)
+	}
+	if err := os.Remove(file); err != nil {
+		t.Fatal(err)
+	}
+	q := new(D.Msg)
+	q.SetQuestion("protected.example.", D.TypeA)
+	if _, err := svc.ServeMsg(context.Background(), q); err == nil {
+		t.Fatal("unreadable hosts fell back to public DNS")
+	}
+}
