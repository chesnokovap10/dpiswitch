@@ -0,0 +1,74 @@
+package hostpolicy
+
+import (
+	"errors"
+	"net/netip"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestDirectPinSurvivesTunnelAddressAndPure(t *testing.T) {
+	oldLookup, oldPolicy, oldV6 := lookupSystemHosts, resolver.SystemHostsDirectOnly, resolver.DisableIPv6
+	t.Cleanup(func() {
+		lookupSystemHosts, resolver.SystemHostsDirectOnly, resolver.DisableIPv6 = oldLookup, oldPolicy, oldV6
+	})
+	resolver.SystemHostsDirectOnly, resolver.DisableIPv6 = true, false
+	pin := netip.MustParseAddr("192.0.2.19")
+	lookupSystemHosts = func(string) ([]netip.Addr, error) { return []netip.Addr{pin}, nil }
+	m := &C.Metadata{Host: "protected.example", DNSMode: C.DNSMapping, DstIP: pin}
+	CaptureSystemHosts(m)
+	if m.Pure().Host == "" {
+		t.Fatal("Pure erased the protected name before the tunnel")
+	}
+	// A retry falls back to DIRECT after a tunnel resolved the public address.
+	m.DstIP = netip.MustParseAddr("203.0.113.20")
+	m.Host, m.SniffHost = "different.example", "different.example"
+	got, pinned, err := DirectSystemHosts(m)
+	if err != nil || !pinned || got.DstIP != pin || got.Host != "" {
+		t.Fatalf("unsafe fallback: %+v, %v, %v", got, pinned, err)
+	}
+	if m.DstIP == pin {
+		t.Fatal("guard changed caller's metadata")
+	}
+	lookupSystemHosts = func(string) ([]netip.Addr, error) { return nil, nil }
+	got, pinned, err = DirectSystemHosts(m)
+	if err != nil || !pinned || got.DstIP != pin {
+		t.Fatal("empty later lookup discarded the flow's pin")
+	}
+	lookupSystemHosts = func(string) ([]netip.Addr, error) { return nil, errors.New("access denied") }
+	if _, _, err = DirectSystemHosts(m); err == nil {
+		t.Fatal("unreadable hosts allowed DIRECT")
+	}
+	// An earlier failed read cannot be healed into an unprotected direct flow.
+	bad := &C.Metadata{Host: "protected.example"}
+	CaptureSystemHosts(bad)
+	lookupSystemHosts = func(string) ([]netip.Addr, error) { return nil, nil }
+	if _, _, err = DirectSystemHosts(bad); err == nil {
+		t.Fatal("failed snapshot was discarded")
+	}
+}
+
+func TestDirectPinAddressFamiliesAndClearedHost(t *testing.T) {
+	oldLookup, oldPolicy, oldV6 := lookupSystemHosts, resolver.SystemHostsDirectOnly, resolver.DisableIPv6
+	t.Cleanup(func() {
+		lookupSystemHosts, resolver.SystemHostsDirectOnly, resolver.DisableIPv6 = oldLookup, oldPolicy, oldV6
+	})
+	resolver.SystemHostsDirectOnly, resolver.DisableIPv6 = true, true
+	v6 := netip.MustParseAddr("2001:db8::19")
+	lookupSystemHosts = func(string) ([]netip.Addr, error) { return []netip.Addr{v6}, nil }
+	m := (&C.Metadata{Host: "protected.example", DNSMode: C.DNSHosts, DstIP: netip.MustParseAddr("203.0.113.20")}).Pure()
+	if _, _, err := DirectSystemHosts(m); err == nil {
+		t.Fatal("IPv6-only pin fell back to public IPv4")
+	}
+	resolver.DisableIPv6 = false
+	got, pinned, err := DirectSystemHosts(m)
+	if err != nil || !pinned || got.DstIP != v6 {
+		t.Fatalf("IPv6 pin lost: %+v %v", got, err)
+	}
+	resolver.SystemHostsDirectOnly = false
+	if got, pinned, err = DirectSystemHosts(m); err != nil || pinned || got != m {
+		t.Fatal("opt-out changed upstream behavior")
+	}
+}
