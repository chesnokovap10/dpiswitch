@@ -0,0 +1,42 @@
+package hosts
+
+import (
+	"fmt"
+	"net/netip"
+	"os"
+	"strings"
+)
+
+// LookupStaticHostStrict never turns an unreadable hosts file into "no pin".
+// Read it for each security decision: the ordinary five-second DNS cache must
+// not open a window after an administrator adds a blocking entry.
+func LookupStaticHostStrict(host string) ([]netip.Addr, error) {
+	body, err := os.ReadFile(hostsFilePath)
+	if err != nil {
+		return nil, fmt.Errorf("read system hosts: %w", err)
+	}
+	return ParseStaticHost(body, host), nil
+}
+
+func ParseStaticHost(body []byte, host string) []netip.Addr {
+	host = strings.TrimSuffix(host, ".")
+	var ips []netip.Addr
+	for _, line := range strings.Split(strings.TrimPrefix(string(body), "\ufeff"), "\n") {
+		line, _, _ = strings.Cut(line, "#")
+		fields := strings.Fields(line)
+		if len(fields) < 2 {
+			continue
+		}
+		ip, err := netip.ParseAddr(fields[0])
+		if err != nil || ip.Zone() != "" {
+			continue
+		}
+		for _, name := range fields[1:] {
+			if strings.EqualFold(strings.TrimSuffix(name, "."), host) {
+				ips = append(ips, ip.Unmap())
+				break
+			}
+		}
+	}
+	return ips
+}
