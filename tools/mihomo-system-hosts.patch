+package outbound
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type tunnelHostsResolver struct{ resolver.Resolver }
+
+func (tunnelHostsResolver) Invalid() bool { return true }
+func (tunnelHostsResolver) LookupIP(context.Context, string) ([]netip.Addr, error) {
+	return []netip.Addr{netip.MustParseAddr("203.0.113.19")}, nil
+}
+func (r tunnelHostsResolver) LookupIPv4(c context.Context, s string) ([]netip.Addr, error) {
+	return r.LookupIP(c, s)
+}
+
+func TestWireGuardHostsPolicyReResolvesPinnedUDP(t *testing.T) {
+	w := &WireGuard{Base: NewBase(BaseOption{Prefer: C.IPv4Only}), option: WireGuardOption{IgnoreSystemHosts: true}, resolver: tunnelHostsResolver{}}
+	m := &C.Metadata{Host: "protected.example", DstIP: netip.MustParseAddr("192.0.2.19"), SystemHostsName: "protected.example", SystemHostsIPs: []netip.Addr{netip.MustParseAddr("192.0.2.19")}}
+	if err := w.ResolveUDP(context.Background(), m); err != nil || m.DstIP.String() != "203.0.113.19" {
+		t.Fatalf("tunnel retained hosts address: %+v %v", m, err)
+	}
+	if m.SystemHostsIPs[0].String() != "192.0.2.19" {
+		t.Fatal("remote resolution destroyed the DIRECT pin")
+	}
+	w.resolver = nil
+	if err := w.ResolveUDP(context.Background(), m); err == nil {
+		t.Fatal("tunnel fell back to OS DNS")
+	}
+	literal := &C.Metadata{DstIP: netip.MustParseAddr("192.0.2.19")}
+	if err := w.ResolveUDP(context.Background(), literal); err != nil || literal.DstIP.String() != "192.0.2.19" {
+		t.Fatalf("literal IP requires no DNS: %v", err)
+	}
+}
diff --git a/component/hostpolicy/system_hosts.go b/component/hostpolicy/system_hosts.go
new file mode 100644
index 00000000..6ca55338
--- /dev/null
+++ b/component/hostpolicy/system_hosts.go
@@ -0,0 +1,80 @@
+package hostpolicy
+
+import (
+	"fmt"
+	"net/netip"
+
+	"github.com/metacubex/mihomo/component/resolver"
+	"github.com/metacubex/mihomo/component/resolver/hosts"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+var lookupSystemHosts = hosts.LookupStaticHostStrict
+
+// CaptureSystemHosts retains the first protected name even if sniffing replaces
+// Host or Pure clears it. A failed read is retained as a direct-only error.
+func CaptureSystemHosts(m *C.Metadata) {
+	if !resolver.SystemHostsDirectOnly {
+		return
+	}
+	name := m.SystemHostsName
+	if name == "" {
+		name = m.Host
+	}
+	if name == "" {
+		name = m.SystemHostsLookupName
+	}
+	if name == "" {
+		name = m.SniffHost
+	}
+	if name == "" {
+		return
+	}
+	if _, err := netip.ParseAddr(name); err == nil {
+		return
+	}
+	ips, err := lookupSystemHosts(name)
+	if err != nil {
+		m.SystemHostsError = err.Error()
+		return
+	}
+	if len(ips) > 0 {
+		m.SystemHostsName = name
+		// The snapshot is not replaced by an empty result on a later lookup.
+		m.SystemHostsIPs = ips
+	}
+}
+
+// DirectSystemHosts is the final authority for every direct adapter, including
+// direct-split and a DIRECT selected by a fallback group. No DNS retry is
+// allowed to replace a hosts pin. Never mutate the caller's routing metadata.
+func DirectSystemHosts(m *C.Metadata) (*C.Metadata, bool, error) {
+	if !resolver.SystemHostsDirectOnly {
+		return m, false, nil
+	}
+	copyM := m.Clone()
+	CaptureSystemHosts(copyM)
+	if copyM.SystemHostsError != "" {
+		return nil, false, fmt.Errorf("direct system hosts guard: %s", copyM.SystemHostsError)
+	}
+	if len(copyM.SystemHostsIPs) == 0 {
+		return copyM, false, nil
+	}
+	var chosen netip.Addr
+	for _, ip := range copyM.SystemHostsIPs {
+		if ip.Is4() {
+			chosen = ip
+			break
+		}
+		if !resolver.DisableIPv6 {
+			chosen = ip
+		}
+	}
+	if !chosen.IsValid() {
+		return nil, true, fmt.Errorf("system hosts pin has no enabled address family")
+	}
+	copyM.Host = ""
+	copyM.DstIP = chosen
+	copyM.DNSMode = C.DNSHosts
+	return copyM, true, nil
+}
