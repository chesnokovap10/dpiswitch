new file mode 100644
index 00000000..6f0a8e27
--- /dev/null
+++ b/component/resolver/system_hosts.go
@@ -0,0 +1,32 @@
+package resolver
+
+import (
+	"context"
+	"strings"
+)
+
+type noSystemHostsKey struct{}
+
+// WithoutSystemHosts is per-request; never toggle the process-wide switch
+// while other direct and tunnel connections are resolving concurrently.
+func WithoutSystemHosts(ctx context.Context, host string) context.Context {
+	return context.WithValue(ctx, noSystemHostsKey{}, strings.TrimSuffix(host, "."))
+}
+
+// The outer tunnel peer always keeps normal hosts handling, even when a DNS
+// request inside that tunnel carries a domain-scoped exception.
+func WithSystemHosts(ctx context.Context) context.Context {
+	return context.WithValue(ctx, noSystemHostsKey{}, "")
+}
+
+func systemHostsIgnored(ctx context.Context, host string) bool {
+	target, _ := ctx.Value(noSystemHostsKey{}).(string)
+	return target != "" && strings.EqualFold(target, strings.TrimSuffix(host, "."))
+}
+
+func RoutingContext(ctx context.Context, host string) context.Context {
+	if SystemHostsDirectOnly {
+		return WithoutSystemHosts(ctx, host)
+	}
+	return ctx
+}
