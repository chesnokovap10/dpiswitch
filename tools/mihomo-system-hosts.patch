+
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"github.com/metacubex/mihomo/component/resolver"
+	"github.com/metacubex/mihomo/component/resolver/hosts"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestHostsCrashWorker(t *testing.T) {
+	file := os.Getenv("MIHOMO_TEST_HOSTS_WORKER")
+	if file == "" {
+		t.Skip("subprocess helper")
+	}
+	defer hosts.SetFileForTest(file)()
+	resolver.SystemHostsDirectOnly, resolver.UseSystemHosts = true, true
+	port, err := strconv.Atoi(os.Getenv("MIHOMO_TEST_HOSTS_PORT"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	d := outbound.NewDirect()
+	for {
+		m := &C.Metadata{Host: "protected.example", DstIP: netip.MustParseAddr("127.0.0.2"), DstPort: uint16(port)}
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		c, err := d.DialContext(ctx, m)
+		cancel()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := c.Write([]byte("probe")); err != nil {
+			c.Close()
+			t.Fatal(err)
+		}
+		c.Close()
+		fmt.Println("hosts-worker-ready")
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+func TestWorkerCrashDoesNotExposeAddressOrChangeHosts(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "hosts")
+	body := []byte("127.0.0.1 protected.example\n")
+	if err := os.WriteFile(file, body, 0600); err != nil {
+		t.Fatal(err)
+	}
+	pinned, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pinned.Close()
+	port := pinned.Addr().(*net.TCPAddr).Port
+	public, err := net.Listen("tcp4", net.JoinHostPort("127.0.0.2", strconv.Itoa(port)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer public.Close()
+	var pinnedHits, publicHits atomic.Int64
+	pinnedConnected := make(chan struct{}, 1)
+	for _, s := range []struct {
+		ln   net.Listener
+		hits *atomic.Int64
+	}{{pinned, &pinnedHits}, {public, &publicHits}} {
+		s := s
+		go func() {
+			for {
+				c, err := s.ln.Accept()
+				if err != nil {
+					return
+				}
+				s.hits.Add(1)
+				if s.hits == &pinnedHits {
+					select {
+					case pinnedConnected <- struct{}{}:
+					default:
+					}
+				}
+				c.Close()
+			}
+		}()
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestHostsCrashWorker$")
+	cmd.Env = append(os.Environ(), "MIHOMO_TEST_HOSTS_WORKER="+file, "MIHOMO_TEST_HOSTS_PORT="+strconv.Itoa(port))
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { cmd.Process.Kill(); cmd.Wait() })
+	scanner := bufio.NewScanner(stdout)
+	ready := false
+	for scanner.Scan() {
+		if strings.Contains(scanner.Text(), "hosts-worker-ready") {
+			ready = true
+			break
+		}
+	}
+	if !ready {
+		t.Fatalf("worker failed: %s", stderr.String())
+	}
+	select {
+	case <-pinnedConnected:
+	case <-ctx.Done():
+		t.Fatal("worker did not reach pinned server")
+	}
+	if err := cmd.Process.Kill(); err != nil {
+		t.Fatal(err)
+	}
+	_ = cmd.Wait()
+	if publicHits.Load() != 0 || pinnedHits.Load() == 0 {
+		t.Fatalf("direct destinations: pinned=%d public=%d", pinnedHits.Load(), publicHits.Load())
+	}
+	after, err := os.ReadFile(file)
+	if err != nil || !bytes.Equal(body, after) {
+		t.Fatalf("worker crash changed hosts: %q %v", after, err)
+	}
+	defer hosts.SetFileForTest(file)()
+	ips, err := hosts.LookupStaticHostStrict("protected.example")
+	if err != nil || len(ips) != 1 || ips[0].String() != "127.0.0.1" {
+		t.Fatalf("pin missing after crash: %v %v", ips, err)
+	}
+}
